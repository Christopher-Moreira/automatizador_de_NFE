# =====================================================================
# .env.example — copie para .env e preencha. NUNCA commite o .env real.
# Todos os segredos e dados da nota ficam AQUI, nunca no código/cron.
# =====================================================================

# ---------------------------------------------------------------------
# Focus NFe (provider que assina e transmite a nota por você)
# ---------------------------------------------------------------------
# Token da API. Use o token de HOMOLOGAÇÃO para testar e o de PRODUÇÃO pra valer.
FOCUS_NFE_TOKEN=seu_token_aqui

# Ambiente: "homologacao" (teste) ou "producao" (emissão real).
FOCUS_NFE_AMBIENTE=homologacao

# ---------------------------------------------------------------------
# Prestador (você / sua empresa)
# ---------------------------------------------------------------------
PRESTADOR_CNPJ=00000000000000
PRESTADOR_INSCRICAO_MUNICIPAL=000000
PRESTADOR_CODIGO_MUNICIPIO=3550308        # IBGE (ex.: 3550308 = São Paulo)

# ---------------------------------------------------------------------
# Tomador (cliente que recebe o serviço na nota)
# ---------------------------------------------------------------------
TOMADOR_CNPJ=00000000000000               # ou TOMADOR_CPF
TOMADOR_CPF=
TOMADOR_RAZAO_SOCIAL=Nome do Cliente LTDA
TOMADOR_EMAIL=cliente@exemplo.com
TOMADOR_CEP=00000000
TOMADOR_LOGRADOURO=Rua Exemplo
TOMADOR_NUMERO=100
TOMADOR_COMPLEMENTO=                        # sala/andar/condomínio (opcional)
TOMADOR_BAIRRO=Centro
TOMADOR_CODIGO_MUNICIPIO=3550308
TOMADOR_UF=SP

# ---------------------------------------------------------------------
# Serviço (o conteúdo fixo da nota mensal)
# ---------------------------------------------------------------------
SERVICO_VALOR=1000.00
SERVICO_ALIQUOTA=2.00                      # % do ISS (MEI com ISS fixo: use 0)
SERVICO_ISS_RETIDO=false
SERVICO_ITEM_LISTA=1.07                    # item da lista de serviços (LC 116)
SERVICO_CODIGO_TRIBUTACAO_NACIONAL=        # código nacional sem pontos (ex.: 170201)
SERVICO_CODIGO_TRIBUTARIO_MUNICIPIO=       # código de serviço do município (se exigido)
# Placeholders dinâmicos: {mes} {ano} {mes_ano} são substituídos pela data da execução.
SERVICO_DISCRIMINACAO=Prestação de serviços referente à competência {mes_ano}.

# ---------------------------------------------------------------------
# E-mail (seu webmail via SMTP) — para onde a nota é enviada
# ---------------------------------------------------------------------
SMTP_HOST=smtp.seuprovedor.com
SMTP_PORT=465
SMTP_SECURE=true                           # true p/ porta 465, false p/ 587
SMTP_USER=voce@seudominio.com
SMTP_PASS=sua_senha_ou_app_password

EMAIL_FROM=voce@seudominio.com
EMAIL_TO=destinatario@exemplo.com          # e-mail fixo que recebe a nota
EMAIL_SUBJECT=Nota Fiscal de Serviço - Mês vigente
EMAIL_BODY=Olá, segue em anexo a nota fiscal de serviço referente ao mês vigente. Atenciosamente.

# ---------------------------------------------------------------------
# Operação
# ---------------------------------------------------------------------
# Se true, monta a nota e loga o payload mas NÃO emite nem envia e-mail.
DRY_RUN=false
# Segundos entre cada checagem de autorização da nota no provider.
POLL_INTERVAL_SECONDS=5
# Máximo de checagens antes de desistir de esperar a autorização.
POLL_MAX_ATTEMPTS=24
